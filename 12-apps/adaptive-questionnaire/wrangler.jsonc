{
  // Cloudflare Pages project config. The site is static; the only server-side
  // code is functions/api/submit.js, which emails a completed brief.
  //
  // nodejs_compat is required because wrangler's own Functions bundler emits a
  // wrapper that references node built-ins. The handler itself imports nothing.
  "name": "jp-adaptive-questionnaire",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"]
}
